{
  "name": "train-app",
  "version": "1.0.0",
  "description": "SaaS de agendamentos para personal trainers",
  "private": true,
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "pnpm -r start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter database run db:generate",
    "db:push": "pnpm --filter database run db:push",
    "db:migrate": "pnpm --filter database run db:migrate",
    "db:seed": "pnpm --filter database run db:seed",
    "db:reset": "pnpm --filter database run db:reset"
  },
  "keywords": [
    "personal-trainer",
    "scheduling",
    "saas"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@8.0.0"
}
