# ============================================================================
# BACKEND SERVER (.env for apps/server)
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trainapp_db

# JWT Secrets (change these in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-in-production

# Redis (optional, for session management and real-time features)
REDIS_URL=redis://localhost:6379

# Stripe (payment processing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (get from Stripe Dashboard)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# SendGrid (email notifications)
SENDGRID_API_KEY=SG.xxx...
SENDGRID_FROM_EMAIL=noreply@trainapp.com

# Logging
LOG_LEVEL=info

# ============================================================================
# FRONTEND (.env.local for apps/web)
# ============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=TrainApp

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Stripe (frontend public key - get from Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true

# ============================================================================
# DOCKER COMPOSE (.env for root directory)
# ============================================================================

# PostgreSQL
POSTGRES_USER=trainapp_user
POSTGRES_PASSWORD=postgres_password_change_this
POSTGRES_DB=trainapp_db

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_password_change_this

# Redis
REDIS_PASSWORD=redis_password_change_this
