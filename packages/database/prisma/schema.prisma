// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  emailVerified   DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  workspace       Workspace?
  trainer         Trainer?
  accounts        Account[]
  authSessions    AuthSession[]
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([email])
}

// ============================================================================
// WORKSPACES (Multi-Tenant)
// ============================================================================

model Workspace {
  id              String    @id @default(cuid())
  ownerId         String    @unique
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  slug            String    @unique @db.VarChar(50)
  displayName     String
  description     String?
  logoUrl         String?

  // Branding
  primaryColor    String    @default("#0099FF")
  secondaryColor  String    @default("#FF6B35")

  // Status
  status          WorkspaceStatus @default(ACTIVE)
  plan            PricingPlan     @default(STARTER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  subscription    Subscription?
  trainer         Trainer?
  students        Student[]
  sessions        Session[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  workoutPrograms WorkoutProgram[]

  @@index([ownerId])
  @@index([slug])
  @@index([status])
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PricingPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ============================================================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================================================

model Subscription {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  plan            PricingPlan
  stripeCustomerId String?   @unique
  stripeSubscriptionId String? @unique

  status          SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  payments        Payment[]

  @@index([workspaceId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  ENDED
}

model Payment {
  id              String    @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  stripePaymentId String    @unique
  amount          Int       // em centavos (ex: 9900 = R$ 99,00)
  currency        String    @default("BRL")

  status          PaymentStatus @default(PENDING)
  invoiceUrl      String?
  receiptUrl      String?

  failureCode     String?
  failureMessage  String?
  failureCount    Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ============================================================================
// TRAINERS (Personal Trainers)
// ============================================================================

model Trainer {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone           String?
  bio             String?
  specialties     String[]  @default([])
  certifications  String[]  @default([])

  // Availability (JSON)
  // Exemplo: { "monday": ["08:00", "09:00"], "tuesday": [] }
  availability    Json      @default("{}")

  activeStudents  Int       @default(0)
  totalSessions   Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  sessions        Session[]
  workoutPrograms WorkoutProgram[]

  @@index([workspaceId])
}

// ============================================================================
// STUDENTS (Alunos)
// ============================================================================

model Student {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  firstName       String
  lastName        String
  email           String?
  phone           String?
  avatarUrl       String?

  // Personal info
  dateOfBirth     DateTime?
  weight          Int?      // em kg
  height          Int?      // em cm
  gender          String?

  // Health & Goals
  goals           String[]  @default([])
  injuries        String[]  @default([])
  restrictions    String?

  // Plan info
  studentPlanId   String?
  studentPlan     StudentPlan? @relation(fields: [studentPlanId], references: [id])

  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  sessions        Session[]
  workoutPrograms WorkoutProgram[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([isActive])
}

// ============================================================================
// STUDENT PLANS (Planos do Aluno)
// ============================================================================

model StudentPlan {
  id              String    @id @default(cuid())

  name            String    // "Mensal", "Trimestral", "Avulso"
  description     String?

  sessionsLimit   Int
  sessionsUsed    Int       @default(0)

  price           Int       // em centavos
  currency        String    @default("BRL")

  startedAt       DateTime  @default(now())
  expiresAt       DateTime

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  // Relations
  students        Student[]

  @@index([expiresAt])
  @@index([isActive])
}

// ============================================================================
// SESSIONS (Sessões de Treino)
// ============================================================================

model Session {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  trainerId       String
  trainer         Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  scheduledAt     DateTime
  durationMinutes Int       @default(60)

  status          SessionStatus @default(SCHEDULED)
  notes           String?

  // Feedback
  studentFeedback String?
  trainerNotes    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  exercises       ExerciseLog[]
  notifications   Notification[]

  @@index([workspaceId])
  @@index([trainerId])
  @@index([studentId])
  @@index([scheduledAt])
  @@index([status])
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// ============================================================================
// EXERCISES & WORKOUT LOGS
// ============================================================================

model ExerciseLog {
  id              String    @id @default(cuid())
  sessionId       String
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exerciseName    String
  sets            Int
  reps            Int
  weight          Int?      // em kg
  restSeconds     Int?      // segundos de descanso

  notes           String?
  imageUrl        String?
  order           Int       @default(0)

  createdAt       DateTime  @default(now())

  @@index([sessionId])
}

model WorkoutProgram {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  trainerId       String
  trainer         Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  studentId       String
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  title           String
  description     String?

  // Exercises as JSON array
  // [{ name, sets, reps, weight, rest }, ...]
  exercises       Json      @default("[]")

  startsAt        DateTime  @default(now())
  endsAt          DateTime?
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([trainerId])
  @@index([studentId])
  @@index([isActive])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId     String?
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  sessionId       String?
  session         Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  type            NotificationType
  title           String
  message         String
  data            Json?     // dados adicionais da notificação

  isRead          Boolean   @default(false)
  readAt          DateTime?
  sentAt          DateTime  @default(now())

  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  SESSION_REMINDER
  SESSION_CONFIRMED
  SESSION_CANCELLED
  SESSION_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  SUBSCRIPTION_EXPIRED
  STUDENT_JOINED
  WORKOUT_UPDATED
  CHAT_MESSAGE
  FEEDBACK_REQUEST
}

// ============================================================================
// AUDIT LOG (Rastreamento)
// ============================================================================

model AuditLog {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: SetNull)

  action          AuditAction
  tableName       String
  recordId        String

  // JSON containing before/after values
  changes         Json?

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime  @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

// ============================================================================
// Sessions para autenticação (NextAuth.js)
// ============================================================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String    @unique
  expires    DateTime

  @@unique([identifier, token])
}
